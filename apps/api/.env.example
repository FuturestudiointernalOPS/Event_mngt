# ---------------------------------------------------------------------------
# Event Platform API environment contract.
# Validated at boot by src/config/env.validation.ts — the process refuses to
# start with a missing or invalid value, listing every problem at once.
#
# Generate the JWT secret with: openssl rand -base64 48
# ---------------------------------------------------------------------------

NODE_ENV=development

# HTTP
PORT=4000
CORS_ORIGINS=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# Database — Supabase PostgreSQL connection string (database only).
# Use the Session pooler host (aws-<n>-<region>.pooler.supabase.com, username
# postgres.<project-ref>); the direct db.<ref>.supabase.co host is IPv6-only and
# unreachable on many networks.
#
# TLS: the pooler presents a certificate chain Node does not trust, so the URL must
# opt out of chain validation. Since pg 8.23 `sslmode=require` means verify-full;
# `sslmode=no-verify` encrypts without validating the certificate.
# e.g. postgresql://postgres.<ref>:password@host:5432/postgres?sslmode=no-verify
DATABASE_URL=

# Runtime connection string. Set this to the non-owner `platform_app` role
# (created by `npm run db:roles`) so row-level security actually applies: table
# owners and roles with BYPASSRLS ignore every policy. Migrations keep using
# DATABASE_URL above. Leave empty in environments without row-level security.
# e.g. postgresql://platform_app:password@host:5432/postgres?sslmode=no-verify
APP_DATABASE_URL=

# Authentication — JWT_ACCESS_SECRET must be at least 32 characters.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Optional
COOKIE_DOMAIN=
LOG_LEVEL=info

# Provider adapters (Phase 2+). Left at console dev adapters until a real
# provider is configured.
# Provider adapters. `local` writes uploads to LOCAL_STORAGE_DIR and serves them from
# PUBLIC_API_URL/static; `console` only logs. s3 is not implemented yet.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
PUBLIC_API_URL=http://localhost:4000
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL objects are served from when STORAGE_PROVIDER=s3
S3_PUBLIC_BASE_URL=

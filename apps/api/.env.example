# ---------------------------------------------------------------------------
# Event Platform API environment contract.
# Validated at boot by src/config/env.validation.ts — the process refuses to
# start with a missing or invalid value, listing every problem at once.
# ---------------------------------------------------------------------------

NODE_ENV=development

# HTTP
PORT=4000
CORS_ORIGINS=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# Database — Supabase PostgreSQL connection string (database only).
# The API MUST connect as a non-owner role so row-level security applies.
# e.g. postgresql://platform_app:password@host:5432/postgres?sslmode=require
DATABASE_URL=

# Authentication (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Optional
COOKIE_DOMAIN=
LOG_LEVEL=info

# Provider adapters (Phase 2+). Left empty in development; the console
# adapters are used until a real provider is configured.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
STORAGE_PROVIDER=console
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

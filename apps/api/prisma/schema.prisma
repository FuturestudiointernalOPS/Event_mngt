// Event Platform — Phase 1 schema (Foundation).
//
// Rules from docs/02-data-model-and-erd.md:
//  - UUID primary keys, explicit foreign keys, snake_case tables (@@map).
//  - Every tenant-owned row carries organization_id directly or through a
//    constrained parent, and is protected by row-level security.
//  - Account (User), Person and Event Registration stay distinct. Person and
//    registration tables arrive with Phase 5 so migrations never conflict.
//
// After editing: npm run db:migrate (dev) or npm run db:deploy (CI).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // The API compiles to CommonJS, so generated imports stay extensionless. That keeps
  // the client resolvable from TypeScript source (ts-node seed, tests) as well as from
  // the compiled output, where sibling .js files exist.
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
  // The connection string lives in prisma.config.ts (required since Prisma 7).
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum EventFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  passwordHash      String     @map("password_hash")
  displayName       String?    @map("display_name")
  status            UserStatus @default(PENDING_VERIFICATION)
  isPlatformAdmin   Boolean    @default(false) @map("is_platform_admin")
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  /// TOTP secret, AES-256-GCM encrypted. Active only once mfaEnabledAt is set.
  mfaSecretEnc      String?    @map("mfa_secret_enc")
  mfaEnabledAt      DateTime?  @map("mfa_enabled_at")
  /// Highest TOTP time step already accepted, so a code cannot be replayed.
  mfaLastStep       BigInt?    @map("mfa_last_step")
  mfaRecoveryHashes String[]   @map("mfa_recovery_hashes")
  mfaFailedAttempts Int        @default(0) @map("mfa_failed_attempts")
  mfaLockedUntil    DateTime?  @map("mfa_locked_until")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  sessions           UserSession[]
  memberships        OrganizationMember[]
  verificationTokens VerificationToken[]
  createdEvents      Event[]              @relation("EventCreator")
  auditLogs          AuditLog[]           @relation("AuditActor")

  @@map("users")
}

/// Refresh sessions. The raw refresh token is never stored — only its hash.
model UserSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @unique @map("refresh_token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  /// Set when this session was rotated; reuse of a revoked token revokes all sessions.
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  createdAt           DateTime  @default(now()) @map("created_at")
  lastUsedAt          DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Single-use, hashed tokens for email verification and password reset.
model VerificationToken {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  type       VerificationTokenType
  tokenHash  String                @unique @map("token_hash")
  expiresAt  DateTime              @map("expires_at")
  consumedAt DateTime?             @map("consumed_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy and access control
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  settings            WorkspaceSettings?
  branding            WorkspaceBranding?
  members             OrganizationMember[]
  roles               OrganizationRole[]
  events              Event[]
  auditLogs           AuditLog[]
  invitations         OrganizationInvitation[]
  people              Person[]
  categories          ParticipantCategory[]
  fields              RegistrationField[]
  registrations       Registration[]
  consents            ConsentRecord[]
  profiles            ParticipantProfile[]
  innovations         Innovation[]
  checkIns            CheckIn[]
  meetings            Meeting[]
  introductions       IntroductionRequest[]
  introductionHistory IntroductionStatusHistory[]

  @@map("organizations")
}

model OrganizationMember {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  roleId          String       @map("role_id") @db.Uuid
  status          MemberStatus @default(ACTIVE)
  invitedByUserId String?      @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime?    @map("joined_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         OrganizationRole @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]
  invitations  OrganizationInvitation[]

  @@unique([organizationId, key])
  @@map("organization_roles")
}

/// Global permission catalogue (`resource:action`). Seeded, not tenant-owned.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Workspace
// ---------------------------------------------------------------------------

model WorkspaceSettings {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  defaultLocale   String   @default("fr") @map("default_locale")
  timeZone        String   @default("Africa/Porto-Novo") @map("time_zone")
  description     String?
  websiteUrl      String?  @map("website_url")
  contactEmail    String?  @map("contact_email")
  /// Participant data is erased this many months after the last event they registered for.
  retentionMonths Int?     @map("retention_months")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

model WorkspaceBranding {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  primaryColor    String   @default("#173F5F") @map("primary_color")
  secondaryColor  String   @default("#206A8A") @map("secondary_color")
  accentColor     String   @default("#F5A623") @map("accent_color")
  backgroundColor String   @default("#FFFFFF") @map("background_color")
  surfaceColor    String   @default("#F5F7FA") @map("surface_color")
  textColor       String   @default("#172B4D") @map("text_color")
  colorMode       String   @default("light") @map("color_mode")
  logoUrl         String?  @map("logo_url")
  logoDarkUrl     String?  @map("logo_dark_url")
  faviconUrl      String?  @map("favicon_url")
  borderRadius    String?  @default("0.5rem") @map("border_radius")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workspace_branding")
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

model Event {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  parentEventId        String?         @map("parent_event_id") @db.Uuid
  slug                 String
  name                 String
  description          String?
  format               EventFormat     @default(IN_PERSON)
  status               EventStatus     @default(DRAFT)
  visibility           EventVisibility @default(PRIVATE)
  timeZone             String          @map("time_zone")
  startsAt             DateTime        @map("starts_at")
  endsAt               DateTime        @map("ends_at")
  venueName            String?         @map("venue_name")
  venueAddress         String?         @map("venue_address")
  registrationOpensAt  DateTime?       @map("registration_opens_at")
  registrationClosesAt DateTime?       @map("registration_closes_at")
  publishedAt          DateTime?       @map("published_at")
  createdByUserId      String          @map("created_by_user_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("EventCreator", fields: [createdByUserId], references: [id])
  parent         Event?                @relation("EventEditions", fields: [parentEventId], references: [id])
  editions       Event[]               @relation("EventEditions")
  modules        EventModule[]
  categories     ParticipantCategory[]
  fields         RegistrationField[]
  registrations  Registration[]
  bannerUrl      String?               @map("banner_url")
  /// Optional colour overrides (primary, secondary, accent); workspace branding applies otherwise.
  brandOverrides Json?                 @map("brand_overrides")
  consentText    String?               @map("consent_text")
  consentVersion String                @default("1") @map("consent_version")

  @@unique([organizationId, slug])
  /// Public URLs are /e/:eventSlug, so a slug must identify exactly one event platform-wide.
  @@unique([slug])
  @@index([organizationId, status])
  @@index([organizationId, startsAt])
  @@map("events")
}

/// Modules enabled for one event. Disabling never deletes history.
model EventModule {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  moduleKey String   @map("module_key")
  enabled   Boolean  @default(true)
  settings  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, moduleKey])
  @@index([eventId])
  @@map("event_modules")
}

// ---------------------------------------------------------------------------
// Governance
// ---------------------------------------------------------------------------

/// Append-only log of sensitive administrative actions. Product data, not telemetry.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 — team invitations
// ---------------------------------------------------------------------------

model OrganizationInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  email           String
  roleId          String    @map("role_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         OrganizationRole @relation(fields: [roleId], references: [id])

  @@index([organizationId, email])
  @@map("organization_invitations")
}

// ---------------------------------------------------------------------------
// Phase 4 — registration, consent, profiles
// ---------------------------------------------------------------------------

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum FieldType {
  TEXT
  EMAIL
  PHONE
  SELECT
  RADIO
  CHECKBOX
  TEXTAREA
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A person known to ONE organisation. Never shared across tenants.
model Person {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  /// Set when the person's data was erased; the row is kept only so counts stay correct.
  erasedAt       DateTime? @map("erased_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([organizationId, email])
  @@map("people")
}

model ParticipantCategory {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  key              String
  name             String
  description      String?
  requiresApproval Boolean  @default(false) @map("requires_approval")
  capacity         Int?
  position         Int      @default(0)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  fields        RegistrationField[]

  @@unique([eventId, key])
  @@index([organizationId])
  @@map("participant_categories")
}

/// One dynamic form per event. A field with no category applies to every category.
model RegistrationField {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  key            String
  label          String
  type           FieldType
  required       Boolean   @default(false)
  options        Json?
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category     ParticipantCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
  @@index([organizationId])
  @@map("registration_fields")
}

model Registration {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  eventId         String             @map("event_id") @db.Uuid
  personId        String             @map("person_id") @db.Uuid
  categoryId      String             @map("category_id") @db.Uuid
  status          RegistrationStatus @default(PENDING)
  answers         Json               @default("{}")
  accessTokenHash String             @unique @map("access_token_hash")
  idempotencyKey  String?            @map("idempotency_key")
  decidedAt       DateTime?          @map("decided_at")
  decidedByUserId String?            @map("decided_by_user_id") @db.Uuid
  decisionNote    String?            @map("decision_note")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person       Person              @relation(fields: [personId], references: [id])
  category     ParticipantCategory @relation(fields: [categoryId], references: [id])
  consents     ConsentRecord[]
  checkIns     CheckIn[]
  profile      ParticipantProfile?
  innovations  Innovation[]

  @@unique([eventId, personId])
  @@unique([eventId, idempotencyKey])
  @@index([organizationId, eventId, status])
  @@map("registrations")
}

model ConsentRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  purpose        String
  policyVersion  String   @map("policy_version")
  granted        Boolean
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([organizationId, registrationId])
  @@map("consent_records")
}

model ParticipantProfile {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  registrationId String        @unique @map("registration_id") @db.Uuid
  headline       String
  bio            String?
  tags           String[]
  isVisible      Boolean       @default(false) @map("is_visible")
  status         ProfileStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventId, status])
  @@map("participant_profiles")
}

model Innovation {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  eventId             String        @map("event_id") @db.Uuid
  ownerRegistrationId String        @map("owner_registration_id") @db.Uuid
  title               String
  summary             String
  sector              String?
  tags                String[]
  isVisible           Boolean       @default(false) @map("is_visible")
  status              ProfileStatus @default(PENDING)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         Registration          @relation(fields: [ownerRegistrationId], references: [id], onDelete: Cascade)
  introductions IntroductionRequest[]

  @@index([organizationId, eventId, status])
  @@map("innovations")
}

// ---------------------------------------------------------------------------
// Phase 5 — operations
// ---------------------------------------------------------------------------

enum CheckInSource {
  ONLINE
  OFFLINE
  MANUAL
}

enum MeetingStatus {
  PROPOSED
  ACCEPTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum IntroductionStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  DECLINED
  INTRODUCED
  CLOSED
}

/// One attendance per registration per event; repeated scans are recorded as duplicates
/// by the unique constraint instead of creating a second attendance.
model CheckIn {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  registrationId  String        @map("registration_id") @db.Uuid
  scannedAt       DateTime      @map("scanned_at")
  source          CheckInSource
  clientScanId    String?       @map("client_scan_id")
  scannedByUserId String?       @map("scanned_by_user_id") @db.Uuid
  syncedAt        DateTime      @default(now()) @map("synced_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([eventId, registrationId])
  @@unique([eventId, clientScanId])
  @@index([organizationId, eventId])
  @@map("check_ins")
}

model Meeting {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  eventId                String        @map("event_id") @db.Uuid
  proposerRegistrationId String        @map("proposer_registration_id") @db.Uuid
  inviteeRegistrationId  String        @map("invitee_registration_id") @db.Uuid
  message                String?
  proposedStart          DateTime?     @map("proposed_start")
  proposedEnd            DateTime?     @map("proposed_end")
  location               String?
  status                 MeetingStatus @default(PROPOSED)
  respondedAt            DateTime?     @map("responded_at")
  outcome                String?
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventId, status])
  @@index([proposerRegistrationId])
  @@index([inviteeRegistrationId])
  @@map("meetings")
}

model IntroductionRequest {
  id                      String             @id @default(uuid()) @db.Uuid
  organizationId          String             @map("organization_id") @db.Uuid
  eventId                 String             @map("event_id") @db.Uuid
  innovationId            String             @map("innovation_id") @db.Uuid
  requesterRegistrationId String             @map("requester_registration_id") @db.Uuid
  reason                  String
  helpOffered             String             @map("help_offered")
  status                  IntroductionStatus @default(SUBMITTED)
  assignedToUserId        String?            @map("assigned_to_user_id") @db.Uuid
  decisionNote            String?            @map("decision_note")
  outcome                 String?
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  innovation   Innovation                  @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  history      IntroductionStatusHistory[]

  @@index([organizationId, eventId, status])
  @@map("introduction_requests")
}

model IntroductionStatusHistory {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  requestId       String              @map("request_id") @db.Uuid
  fromStatus      IntroductionStatus? @map("from_status")
  toStatus        IntroductionStatus  @map("to_status")
  changedByUserId String?             @map("changed_by_user_id") @db.Uuid
  note            String?
  createdAt       DateTime            @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      IntroductionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("introduction_status_history")
}

// ---------------------------------------------------------------------------
// Platform-level module availability (Super Admin). Global, not tenant-owned.
// ---------------------------------------------------------------------------

model PlatformModuleSetting {
  moduleKey String   @id @map("module_key")
  available Boolean
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_module_settings")
}
